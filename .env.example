# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-string
BETTER_AUTH_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://ai_cooking_battle:ai_cooking_battle@localhost:5432/ai_cooking_battle?schema=public
POSTGRES_PORT=5432

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Rewarded Ads (Google Ad Manager / GPT)
# 예: /NETWORK_CODE/your-rewarded-unit
NEXT_PUBLIC_GAM_REWARDED_AD_UNIT=
# Rewarded Ads Mocking (true | false)
# true: 로컬에서 모의 광고 재생
NEXT_PUBLIC_IS_AD_MOCKING=

# OpenAI (Prompt Validation / Safety Check / Day Theme / Bot Dish Prompt)
OPENAI_API_KEY=
OPENAI_PROMPT_VALIDATION_MODEL=gpt-5-mini
OPENAI_SAFETY_CHECK_MODEL=gpt-5-mini
OPENAI_DAY_THEME_MODEL=gpt-5-mini
OPENAI_BOT_DISH_PROMPT_MODEL=gpt-5-mini
OPENAI_DISH_SCORE_MODEL=gpt-5-mini

# Dish Score Recovery Watchdog
# auto requeue scan settings (worker schedule: every 10 minutes)
# DISH_SCORE_RECOVERY_LIMIT:
#   watchdog 1회 실행 시 재큐잉할 최대 건수
#   (값이 클수록 복구는 빠르지만 큐 부하 증가)
DISH_SCORE_RECOVERY_LIMIT=100
# DISH_SCORE_RECOVERY_STALE_MINUTES:
#   updatedAt 기준으로 이 시간(분) 이상 정체된 건만 복구 대상으로 간주
#   (값이 작으면 과도 재큐잉, 크면 복구 지연)
DISH_SCORE_RECOVERY_STALE_MINUTES=10
# DISH_SCORE_RECOVERY_LOOKBACK_DAYS:
#   자동 복구 스캔 시 조회할 최근 dayKey 범위(일)
#   (today 포함 최근 N일, 값이 클수록 조회 범위/비용 증가)
DISH_SCORE_RECOVERY_LOOKBACK_DAYS=2

# Deployment (start:all)
# true|false - start:all에서 worker 실행 여부 제어
RUN_WORKER=true

# Leesfield (Image Generation)
LEESFIELD_BASE_URL=https://leesfield.leey00nsu.com
LEESFIELD_API_KEY=
# Leesfield image model key (GET /api/external/models -> items[].key)
LEESFIELD_IMAGE_MODEL=

# Leemage (Image Storage)
LEEMAGE_BASE_URL=https://leemage.leey00nsu.com
LEEMAGE_API_KEY=
LEEMAGE_PROJECT_ID=
